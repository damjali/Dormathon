# Supabase (existing auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key — used server-side only (lib/supabase/admin.ts) for the
# private tiktok-reference-files storage bucket. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail integration (Emails sidebar section) — connects over IMAP with an
# app password, no OAuth consent screen. See context.md for setup steps.
GMAIL_BOT_EMAIL=averisbot@gmail.com
GMAIL_APP_PASSWORD=

# WorkBuddy AI (TikTok Live "Answer" button) — local CodeBuddy HTTP gateway.
# Run `codebuddy /login` once, then `codebuddy --serve --port 8321` and copy
# the printed endpoint/password below. See context.md for details.
WORKBUDDY_API_URL=http://127.0.0.1:8321
WORKBUDDY_API_TOKEN=
